	"passportFieldList": [
		{
			"meaning": "constant discriminator graphProvenance (ruled -Key exception)",
			"name": "passportKey",
			"required": true,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "ISO-8601 instant finish ran; the verb's only clock",
			"name": "builtAt",
			"required": true,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "the manifest this graph was replayed from (64 hex)",
			"name": "manifestRefId",
			"required": true,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "container name; the stamp overwrites with the promoted name",
			"name": "graphName",
			"required": true,
			"type": "string",
			"writer": "finish+stamp"
		},
		{
			"meaning": "the name finish saw",
			"name": "scratchGraphName",
			"required": false,
			"type": "string",
			"writer": "stamp"
		},
		{
			"meaning": "nodes carrying _source",
			"name": "contentNodeCount",
			"required": true,
			"type": "integer",
			"writer": "finish"
		},
		{
			"meaning": "edges with no :GraphMeta endpoint",
			"name": "contentEdgeCount",
			"required": true,
			"type": "integer",
			"writer": "finish"
		},
		{
			"meaning": "distinct _source values",
			"name": "standardCount",
			"required": true,
			"type": "integer",
			"writer": "finish"
		},
		{
			"meaning": "sorted distinct _source values",
			"name": "standardsIncluded",
			"required": true,
			"type": "stringList",
			"writer": "finish"
		},
		{
			"meaning": "mapping edges + non-structural tiered edges",
			"name": "meaningBearingEdgeCount",
			"required": true,
			"type": "integer",
			"writer": "finish"
		},
		{
			"meaning": "array of {edgeType, mappingKind, mappingSource, tierCount} | {edgeType, provenanceTier, tierCount}",
			"name": "meaningTierBreakdown",
			"parse": "MEANING_TIER_ROW_FIELD_LIST_BY_SHAPE",
			"required": true,
			"type": "jsonString",
			"writer": "finish"
		},
		{
			"meaning": "provenance verdict",
			"name": "trustworthyForMeaning",
			"required": true,
			"type": "boolean",
			"writer": "finish"
		},
		{
			"meaning": "noMeaningBearingEdges | invalidDebugPresent | allMeaningBearingEdgesCarryAValidTier",
			"name": "trustBasis",
			"required": true,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "the verdict in words; provenance, not correctness",
			"name": "trustNote",
			"required": true,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "why no previous build is recorded",
			"name": "previousManifestRefIdBasis",
			"required": true,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "{ replayManager, replayEngine, serializer, forgeFramework, bridgeFramework }",
			"name": "engineVersions",
			"parse": "ENGINE_VERSIONS_NAME_LIST",
			"required": true,
			"type": "jsonString",
			"writer": "finish"
		},
		{
			"meaning": "the one distinct embeddingModelVersion over :ForgedNode; refused when ≠ 1",
			"name": "embeddingModelVersion",
			"required": true,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "the one distinct vector width over embedding and textEmbedding; refused when ≠ 1",
			"name": "embeddingDims",
			"required": true,
			"type": "integer",
			"writer": "finish"
		},
		{
			"meaning": "present ONLY when the graph carries no vector (--vectorize=false): names that fact; then the two fields above are absent by declaration",
			"name": "embeddingBasis",
			"required": false,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "sorted distinct judge identities over mapping edges; [] when none",
			"name": "judgeIdentityList",
			"required": true,
			"type": "stringList",
			"writer": "finish"
		},
		{
			"meaning": "sorted distinct renderer versions over mapping edges; [] when none",
			"name": "rendererVersionList",
			"required": true,
			"type": "stringList",
			"writer": "finish"
		},
		{
			"meaning": "copied from the ManifestRecipe this graph was BUILT_FROM",
			"name": "recipeHash",
			"required": true,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "copied from the same row",
			"name": "recipeName",
			"required": true,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "the VECTOR index names as created, rewritten by the stamp after the rename (§10)",
			"name": "vectorIndexNameList",
			"required": true,
			"type": "stringList",
			"writer": "finish+stamp"
		},
		{
			"meaning": "sha256 of the canonical graphContract.json this build ran with",
			"name": "graphContractSha256",
			"required": true,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "the one frameworkFingerprint every bridge run report carried; absent when none or when they disagree",
			"name": "frameworkFingerprint",
			"required": false,
			"type": "string",
			"writer": "finish"
		},
		{
			"meaning": "present iff frameworkFingerprint is absent: why",
			"name": "frameworkFingerprintBasis",
			"required": false,
			"type": "string",
			"writer": "finish"
		}
	],
